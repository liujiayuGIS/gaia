  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The active accent and computed foreground identify the committed action.",
      "html": "<button class=\"ds-primary\">应用设置</button>",
      "css": ".ds-primary{font:13px/1.5 'Segoe UI',-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;background:var(--accent,#087f79);color:var(--accent-ink,#ffffff);border:1px solid var(--accent,#087f79);border-radius:8px;min-height:32px;padding:5px 9px;font-weight:600;cursor:pointer;}.ds-primary:hover:not(:disabled){filter:brightness(.93);}.ds-primary:focus-visible{outline:2px solid var(--accent,#087f79);outline-offset:2px;}.ds-primary:disabled{opacity:.48;cursor:default;}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A quiet bordered action within a pane.",
      "html": "<button class=\"ds-secondary\">恢复默认</button>",
      "css": ".ds-secondary{font:13px/1.5 'Segoe UI',-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;color:var(--ink,#243530);background:var(--control,#f5f7f6);border:1px solid var(--border,#cbd4d1);border-radius:8px;min-height:32px;padding:5px 9px;cursor:pointer;}.ds-secondary:hover:not(:disabled){background:var(--hover,#edf2f0);}.ds-secondary:focus-visible{outline:2px solid var(--accent,#087f79);outline-offset:2px;}.ds-secondary:disabled{opacity:.48;cursor:default;}"
    },
    {
      "name": "Icon action",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Transparent compact command with an inline SVG and accessible name.",
      "html": "<button class=\"ds-icon\" aria-label=\"关闭弹窗\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></button>",
      "css": ".ds-icon{font:13px/1.5 'Segoe UI',-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;display:inline-flex;align-items:center;justify-content:center;color:var(--ink,#243530);background:transparent;border:1px solid transparent;border-radius:8px;min-height:24px;padding:4px;cursor:pointer;}.ds-icon:hover{background:var(--hover,#edf2f0);}.ds-icon:focus-visible{outline:2px solid var(--accent,#087f79);outline-offset:2px;}"
    },
    {
      "name": "Labeled field",
      "kind": "input",
      "refersTo": "field",
      "description": "Theme-bound field with a compact label and clear focus.",
      "html": "<label class=\"ds-field-label\">输出数据名称<input class=\"ds-field\" value=\"GAIA 验收 · 质心\"/></label>",
      "css": ".ds-field-label{font:13px/1.5 'Segoe UI',-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;display:flex;flex-direction:column;gap:5px;font-size:11px;color:var(--ink,#243530);}.ds-field{font:13px/1.5 'Segoe UI',-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;min-width:0;min-height:33px;padding:5px 7px;color:var(--ink,#243530);background:var(--input,#fbfcfb);border:1px solid var(--border,#cbd4d1);border-radius:7px;}.ds-field:focus-visible{outline:2px solid var(--accent,#087f79);outline-offset:2px;}"
    },
    {
      "name": "Document switch",
      "kind": "nav",
      "refersTo": "switch",
      "description": "The restrained map/layout segmented context switch.",
      "html": "<nav class=\"ds-switch\" aria-label=\"文档\"><button class=\"ds-switch-item ds-selected\">地图</button><button class=\"ds-switch-item\">出图布局</button></nav>",
      "css": ".ds-switch{font:13px/1.5 'Segoe UI',-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;display:inline-flex;align-items:center;gap:3px;height:30px;padding:3px;background:var(--ground,#f1f4f3);border-radius:8px;}.ds-switch-item{font:13px/1.5 'Segoe UI',-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;font-size:11px;font-weight:500;min-height:24px;padding:2px 12px;background:transparent;color:var(--ink,#243530);border:0;border-radius:6px;cursor:pointer;}.ds-switch-item.ds-selected{background:var(--pane,#ffffff);box-shadow:0 1px 3px #0002;color:var(--accent-ui,var(--accent,#087f79));font-weight:600;}.ds-switch-item:hover{background:var(--hover,#edf2f0);}.ds-switch-item:focus-visible{outline:2px solid var(--accent,#087f79);outline-offset:2px;}"
    },
    {
      "name": "Context navigation",
      "kind": "nav",
      "refersTo": "context-nav",
      "description": "Data/tool context changes stay local to the left pane.",
      "html": "<nav class=\"ds-context-nav\" aria-label=\"工作区面板\"><button class=\"ds-context-item ds-current\">数据</button><button class=\"ds-context-item\">工具</button><button class=\"ds-context-item\">格式</button><button class=\"ds-context-item\">目录</button></nav>",
      "css": ".ds-context-nav{font:13px/1.5 'Segoe UI',-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;display:flex;gap:3px;height:42px;padding:5px 6px;background:var(--pane,#ffffff);border:1px solid var(--border,#cbd4d1);border-bottom:0;border-radius:13px 13px 0 0;}.ds-context-item{font:13px/1.5 'Segoe UI',-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;flex:1;min-width:0;min-height:30px;padding:4px 3px;font-size:11px;background:transparent;color:var(--ink,#243530);border:0;border-radius:6px;cursor:pointer;}.ds-context-item.ds-current{background:var(--selection,color-mix(in srgb,var(--accent,#087f79) 13%,var(--pane,#ffffff)));color:var(--accent-ui,var(--accent,#087f79));font-weight:600;}.ds-context-item:hover{background:var(--hover,#edf2f0);}.ds-context-item:focus-visible{outline:2px solid var(--accent,#087f79);outline-offset:2px;}"
    },
    {
      "name": "Working pane",
      "kind": "card",
      "refersTo": "pane",
      "description": "Finely bordered, flat operational surface.",
      "html": "<section class=\"ds-pane\"><h2 class=\"ds-pane-title\">GAIA 助手</h2><p class=\"ds-pane-copy\">导入数据，告诉 GAIA 你想分析什么。</p></section>",
      "css": ".ds-pane{font:13px/1.5 'Segoe UI',-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;color:var(--ink,#243530);background:var(--pane,#ffffff);border:1px solid var(--border,#cbd4d1);border-radius:13px;overflow:hidden;}.ds-pane-title{display:flex;align-items:center;height:46px;padding:0 16px;margin:0;border-bottom:1px solid var(--border-soft,#e5eae8);font-size:15px;font-weight:600;}.ds-pane-copy{font-size:12px;line-height:1.9;color:var(--muted,#63736d);margin:18px 16px;}"
    },
    {
      "name": "Assistant composer",
      "kind": "custom",
      "refersTo": "assistant-composer",
      "description": "Bound-layer context, open task entry and a compact action remain one surface.",
      "html": "<form class=\"ds-composer\"><div class=\"ds-composer-context\">雷尼尔山 DEM · USGS 3DEP</div><textarea class=\"ds-composer-text\" aria-label=\"自然语言任务\" placeholder=\"向 GAIA 描述你的地理问题…\"></textarea><button class=\"ds-composer-send\" type=\"button\">发送任务</button></form>",
      "css": ".ds-composer{font:13px/1.5 'Segoe UI',-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;display:flex;flex-direction:column;align-items:flex-start;padding:11px;border:1px solid var(--border,#cbd4d1);border-radius:12px;background:var(--input,#fbfcfb);}.ds-composer:focus-within{border-color:var(--accent-ui,var(--accent,#087f79));box-shadow:0 0 0 2px color-mix(in srgb,var(--accent,#087f79) 12%,transparent);}.ds-composer-context{font-size:10px;color:var(--muted,#63736d);padding-bottom:7px;border-bottom:1px solid var(--border-soft,#e5eae8);width:100%;}.ds-composer-text{font:13px/1.5 'Segoe UI',-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;font-size:12px;color:var(--ink,#243530);width:100%;padding:9px 1px;min-height:100px;resize:vertical;border:0;outline:none;background:transparent;}.ds-composer-send{font:13px/1.5 'Segoe UI',-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;align-self:flex-end;font-size:11px;font-weight:600;min-height:30px;padding:4px 10px;color:var(--accent-ink,#ffffff);background:var(--accent,#087f79);border:1px solid var(--accent,#087f79);border-radius:8px;cursor:pointer;}.ds-composer-send:hover:not(:disabled){filter:brightness(.93);}.ds-composer-send:focus-visible{outline:2px solid var(--accent,#087f79);outline-offset:2px;}.ds-composer-send:disabled{opacity:.48;cursor:default;}"
    }
  ],
  "narrative": {
    "northStar": "The GAIA Workspace",
    "overview": "GAIA uses its supplied navy-and-mint orbital G identity inside a quiet, rounded GIS workspace. Neutral daylight and slate surfaces support precise controls, readable data and a central map or print document. The confirmed direction replaces the earlier vendor imitation with GAIA's own identity.\n\nThe interface is compact and operational. Boundaries are fine strokes; selection is a restrained tint; segmented controls change context without becoming a ribbon. The desktop assistant remains an independent surface at the right while contextual tools occupy the left.",
    "keyCharacteristics": [
      "User-supplied orbital G identity, preserved unchanged.",
      "Daylight and slate themes with a user-configurable accent.",
      "Rounded, finely bordered operational surfaces.",
      "Concentrated map/document workspace with an independent assistant.",
      "Explicit full-width pane navigation on narrow screens."
    ],
    "rules": [
      {
        "name": "The Independent Color Rule",
        "body": "Changing the workspace accent must not recolor geographic symbology or the white print page.",
        "section": "colors"
      },
      {
        "name": "The Context Rule",
        "body": "On desktop, data, tools, formatting and catalog change the left context; they do not replace the assistant at the right.",
        "section": "layout"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use borders and tonal separation for workspace panes; reserve shadows for the print sheet, selected segments and overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the supplied orbital G image and its adjacent provenance file.",
      "Do bind reusable surfaces to the active theme variables and use the derived accent color for small links and selected labels.",
      "Do keep the desktop assistant separate and use the three explicit pane choices at narrow widths.",
      "Do retain horizontal native checkbox rows and clear separation between output labels and fields.",
      "Do keep print paper white and map styling independent of workspace appearance.",
      "Do preserve visible keyboard focus, native dialog behavior and reduced-motion handling."
    ],
    "donts": [
      "Don't restore the rejected ArcGIS Pro imitation or its vendor-style ribbon.",
      "Don't use brand artwork as a recolorable workspace accent.",
      "Don't squeeze the three desktop columns into a narrow viewport.",
      "Don't turn settings, tool forms or the catalog into replacements for the desktop conversation.",
      "Don't add decorative glass, glow or hard offset shadows to the operational surfaces."
    ]
  }
}
